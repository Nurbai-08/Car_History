NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://carhistory:local-development-only@127.0.0.1:55432/carhistory
REDIS_URL=redis://127.0.0.1:6379
# Generate your own: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ISSUER=carhistory
JWT_AUDIENCE=carhistory-web
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3001
COOKIE_DOMAIN=
# Number of reverse proxies in front of the API (Railway only; ignored locally).
TRUST_PROXY_HOPS=1
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_PUBLIC_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_PATH_STYLE=true
STORAGE_ACCESS_KEY=S3RVER
STORAGE_SECRET_KEY=S3RVER
STORAGE_BUCKET=carhistory
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=CarHistory <noreply@carhistory.test>
UPLOAD_MAX_BYTES=15728640
USER_STORAGE_MAX_BYTES=524288000
# Required in production before uploaded files become available:
CLAMAV_HOST=
CLAMAV_PORT=3310

# Optional isolated test database; never use the main database.
TEST_DATABASE_URL=postgresql://carhistory:local-development-only@127.0.0.1:55432/carhistory_test

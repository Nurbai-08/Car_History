# Shared by the Railway API and worker services.
NODE_ENV=production
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
JWT_ACCESS_SECRET=generate-a-random-value-with-at-least-32-characters
JWT_ISSUER=carhistory
JWT_AUDIENCE=carhistory-web
FRONTEND_URL=https://your-project.vercel.app
TRUST_PROXY_HOPS=2

# Railway Storage Bucket (copy the reference variables from the bucket service).
STORAGE_ENDPOINT=${{Bucket.ENDPOINT}}
STORAGE_PUBLIC_ENDPOINT=${{Bucket.PUBLIC_ENDPOINT}}
STORAGE_REGION=${{Bucket.REGION}}
STORAGE_PATH_STYLE=true
STORAGE_ACCESS_KEY=${{Bucket.ACCESS_KEY_ID}}
STORAGE_SECRET_KEY=${{Bucket.SECRET_ACCESS_KEY}}
STORAGE_BUCKET=${{Bucket.BUCKET}}

# SMTP provider. These values are required by the worker for verification/reset email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_SECURE=false
MAIL_FROM=CarHistory <noreply@example.com>

# ClamAV is required for production file uploads.
CLAMAV_HOST=${{ClamAV.RAILWAY_PRIVATE_DOMAIN}}
CLAMAV_PORT=3310
UPLOAD_MAX_BYTES=15728640
USER_STORAGE_MAX_BYTES=524288000
